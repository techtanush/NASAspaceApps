{
    admin off
}

{$APP_HOSTS} {
    @alias not host {$APP_HOST}
    redir @alias https://{$APP_HOST}{uri} permanent
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    @combinedBrief path /api/v1/runs/*/test-brief.pdf
    handle @combinedBrief {
        reverse_proxy api:8000 {
            transport http {
                dial_timeout 5s
                # A packet reads several sites before the bounded PDF render.
                response_header_timeout 60s
            }
        }
    }
    @backend path /api/* /auth/* /artifacts/*
    handle @backend {
        reverse_proxy api:8000 {
            # Each progress event must reach the browser immediately.
            flush_interval -1
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
            }
        }
    }
    handle /assets/* {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv
        try_files {path} /index.html
        header Cache-Control "no-cache"
        file_server
    }
}
