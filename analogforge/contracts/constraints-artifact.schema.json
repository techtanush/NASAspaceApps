          "title": "Calibration Evidence Id"
        }
      },
      "required": [
        "model_id",
        "rolling_coefficient",
        "drive_efficiency",
        "idle_power_w",
        "science_task_wh",
        "roughness_multiplier",
        "uncertainty_fraction",
        "calibration_status",
        "calibration_evidence_id"
