        "drive_efficiency": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Drive Efficiency",
          "type": "number"
        },
        "idle_power_w": {
          "minimum": 0.0,
          "title": "Idle Power W",
          "type": "number"
        },
        "science_task_wh": {
          "minimum": 0.0,
          "title": "Science Task Wh",
          "type": "number"
        },
        "roughness_multiplier": {
          "minimum": 1.0,
          "title": "Roughness Multiplier",
          "type": "number"
        },
        "uncertainty_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Uncertainty Fraction",
          "type": "number"
        },
        "calibration_status": {
          "enum": [
            "ASSUMED",
            "CALIBRATED"
