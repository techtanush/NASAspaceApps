    {"id": "M1", "fg": "border-subtle",  "bg": ["canvas"], "min": 1.2, "why": "hairlines must be visible but quiet (not a control boundary)"}
  ],
  "distinctness_rules": [
    {"id": "D1", "what": "every pair of the six state colours differs by CIE76 deltaE >= 18 in each theme", "min_delta_e": 18}
