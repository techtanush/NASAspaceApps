  "contrast_rules": [
    {"id": "T1", "fg": "text-primary",   "bg": ["canvas", "surface-1", "surface-2", "surface-3"], "min": 7.0, "why": "body text, AAA"},
    {"id": "T2", "fg": "text-secondary", "bg": ["canvas", "surface-1", "surface-2", "surface-3"], "min": 4.5, "why": "secondary text, AA"},
