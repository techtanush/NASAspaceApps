{
  "name": "@analogforge/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mock": "VITE_API_MOCK=1 vite --host 127.0.0.1 --mode mock",
    "generate:client": "openapi-typescript ../../contracts/openapi.bundled.json -o src/generated/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:contracts": "vitest run src/test/testids.test.ts src/test/msw-validate.test.ts",
    "build": "node ../../scripts/ui/generate_assurance_validator.mjs --check && vite build",
    "test:e2e": "playwright test",
    "test:e2e:mock": "E2E_TARGET=mock playwright test",
    "a11y": "E2E_TARGET=mock playwright test a11y",
    "audit:visual": "node ../../scripts/ui/visual_audit.mjs",
    "verify:tokens": "python3 ../../scripts/ui/verify_tokens.py",
    "generate:assurance": "node ../../scripts/ui/generate_assurance_validator.mjs",
    "check:assurance": "node ../../scripts/ui/generate_assurance_validator.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/inter": "5.2.8",
    "@noble/hashes": "2.0.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@radix-ui/react-visually-hidden": "1.2.3",
    "@tanstack/react-query": "5.90.10",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "clsx": "2.1.1",
    "d3-array": "3.2.4",
    "d3-axis": "3.0.0",
    "d3-format": "3.1.0",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "d3-time-format": "4.1.0",
    "lucide-react": "0.554.0",
    "maplibre-gl": "6.18.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/d3-scale": "4.0.9",
    "@types/node": "22.19.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "json-canonicalize": "1.2.0",
    "msw": "2.12.2",
    "openapi-typescript": "7.10.1",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
