{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "candidate_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "body": {
      "type": "string",
      "enum": [
        "EARTH",
        "MARS",
        "MOON"
      ]
    },
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "dataset_lock_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "availability": {
      "enum": [
        "AVAILABLE",
        "PARTIAL",
        "UNAVAILABLE"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "display_layer_manifest_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "candidate_id",
    "body",
    "bbox",
    "dataset_lock_id",
    "availability",
    "reason",
    "display_layer_manifest_ids"
  ]
}
