# Optional server-side extensions. Keep actual credentials in your private environment.
# These values are not part of the immutable contract-kit .env.example.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_ENABLED=false

# Optional ordered rate-limit-only text-provider fallbacks. Omit this variable for
# legacy GROQ_FALLBACK_ENABLED behavior; [] disables all fallbacks explicitly.
# MODEL_FALLBACK_ORDER=["groq","openrouter","anthropic","sambanova","nvidia","gemini"]
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.4-nano
OPENROUTER_UPSTREAM=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Native Anthropic uses documented structural wire schema adaptation. Gemini,
# SambaNova and NVIDIA use a single-tool JSON-schema envelope. Full ORIGINAL
# schema validation and scientific authorization remain mandatory locally.
# Provider schema/model access must be verified before enabling each provider.
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=DeepSeek-V3.1
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional local pacing: leave unset (0 seconds), or set a finite value in [0,60].
# 60 spaces requests one minute apart; this cannot increase an account's token or request limits.
# OPENAI_MIN_REQUEST_INTERVAL_SECONDS=
ANALOGFORGE_ENVIRONMENT_CONTEXT=false
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# Optional smaller primary output allowance, integer 256–4096; default 4096.
# A lower cap can help fit existing token-rate limits; account quotas do not change.
# OPENAI_MAX_OUTPUT_TOKENS=
